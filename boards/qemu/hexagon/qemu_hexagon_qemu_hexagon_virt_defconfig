# Console via PL011 UART
CONFIG_SERIAL=y
CONFIG_UART_PL011=y
CONFIG_UART_CONSOLE=y
CONFIG_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_EARLY_CONSOLE=y

# Build system configuration
CONFIG_COMPILER_RT_RTLIB=y
CONFIG_BUILD_OUTPUT_BIN=y

# Hexagon-specific features
CONFIG_HEXAGON_TIMER=y
CONFIG_DYNAMIC_INTERRUPTS=y

# Debug and development options
CONFIG_EXCEPTION_DEBUG=y
CONFIG_QEMU_ICOUNT_SHIFT=3

# Advanced features
CONFIG_HW_STACK_PROTECTION=y
CONFIG_STACK_SENTINEL=y
CONFIG_PM=y
CONFIG_USERSPACE=y
CONFIG_THREAD_CUSTOM_DATA=y

# Hexagon requires larger stacks due to deep syscall call chains
# with CONFIG_USERSPACE and the register-heavy ABI (callee-saved
# r16-r27 are 48 bytes per frame).
CONFIG_MAIN_STACK_SIZE=4096
CONFIG_ZTEST_STACK_SIZE=4096
CONFIG_PRIVILEGED_STACK_SIZE=4096
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=4096
CONFIG_IDLE_STACK_SIZE=2048
CONFIG_ISR_STACK_SIZE=4096
CONFIG_TEST_EXTRA_STACK_SIZE=4096
